{
  "name": "hawshemi-website",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "persist": true
    }
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
