---
import { Icon } from 'astro-icon/components';
import { ui } from '../../i18n/ui';
import Button from '../Button.astro';

interface Props {
  lang: 'en' | 'fa';
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="max-w-2xl">
  <header class="page-heading">
    <h1 class="page-title">{t['contact.title']}</h1>
    <p class="page-intro">{t['contact.intro']}</p>
  </header>
  <Button href={`mailto:${t['contact.email']}`} variant="primary" size="lg" class="max-w-full" lang="en" dir="ltr">
    <Icon name="lucide:mail" class="size-5" aria-hidden="true" />
    <span class="min-w-0 break-all">{t['contact.email']}</span>
  </Button>
</section>
