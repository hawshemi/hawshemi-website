---
import { Icon } from 'astro-icon/components';
import Card from '../Card.astro';
import { getCollection } from 'astro:content';
import { ui } from '../../i18n/ui';

interface Props {
  lang: 'en' | 'fa';
}

const { lang } = Astro.props;
const t = ui[lang];
const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
const publications = (await getCollection('publications'))
  .filter(pub => pub.data.lang === lang)
  .sort((a, b) => b.data.year - a.data.year)
  .map(pub => pub.data);
---

<section>
  <header class="page-heading">
    <h1 class="page-title">{t['works.subtitle']}</h1>
    <p class="page-intro">{t['works.description']}</p>
  </header>

  <section aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="mb-4 text-lg font-semibold">{t['works.heading.projects']}</h2>
    {projects.length === 0 ? (
      <p class="panel p-5 text-text-secondary">{t['works.empty.projects']}</p>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <Card title={p.data.title} href={p.data.links?.repo ?? p.data.links?.demo} lang={lang}>
            <p>{p.data.summary}</p>
            {p.data.tags && (
              <ul slot="tags" class="flex flex-wrap gap-1.5 text-xs text-text-secondary">
                {p.data.tags.map((tag: string) => (
                  <li class="rounded-md border border-border px-2 py-0.5">{tag}</li>
                ))}
              </ul>
            )}
          </Card>
        ))}
      </div>
    )}
  </section>

  <section class="mt-9" aria-labelledby="publications-heading">
    <h2 id="publications-heading" class="mb-4 text-lg font-semibold">{t['works.heading.publications']}</h2>
    {publications.length === 0 ? (
      <p class="panel p-5 text-text-secondary">{t['works.empty.publications']}</p>
    ) : (
      <div class="space-y-4">
        {publications.map((pub) => (
          <article class="panel p-5 sm:p-6">
            {pub.year && <p class="mb-2 text-sm tabular-nums text-text-secondary">{new Intl.NumberFormat(lang, { useGrouping: false }).format(pub.year)}</p>}
            <h3 class="max-w-3xl text-lg font-semibold">{pub.title}</h3>
            <p class="mt-3 max-w-3xl text-sm text-text-secondary">{pub.summary}</p>
            {!!pub.tags?.length && (
              <ul class="mt-4 flex flex-wrap gap-1.5 text-xs text-text-secondary">
                {pub.tags.map((tag: string) => (
                  <li class="rounded-md border border-border px-2 py-0.5">{tag}</li>
                ))}
              </ul>
            )}
            {pub.link && (
              <a href={pub.link} class="text-link mt-3 inline-flex min-h-11 items-center gap-2 text-sm">
                {t['works.read']}
                <span class="sr-only">: {pub.title}</span>
                <Icon name="lucide:arrow-up-right" class="size-4 rtl:-scale-x-100" aria-hidden="true" />
              </a>
            )}
          </article>
        ))}
      </div>
    )}
  </section>
</section>
