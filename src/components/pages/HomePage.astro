---
import { Icon } from 'astro-icon/components';
import { ui } from '../../i18n/ui';
import Button from '../Button.astro';

interface Props {
  lang: 'en' | 'fa';
}

const { lang } = Astro.props;
const t = ui[lang];
const base = lang === 'fa' ? '/fa' : '';
---

<section class="max-w-2xl py-6 sm:py-12">
  <p class="mb-5 text-sm font-medium text-accent">{t['hero.role']}</p>
  <h1 class="text-4xl font-semibold leading-tight sm:text-5xl">{t['hero.title']}</h1>
  <p class="mt-5 max-w-xl text-base leading-relaxed text-text-secondary sm:text-lg">{t['hero.description']}</p>
  <div class="mt-8 flex flex-wrap gap-3">
    <Button href={`${base}/works`}>
      {t['hero.works']}
      <Icon name="lucide:arrow-up-right" class="size-4 rtl:-scale-x-100" aria-hidden="true" />
    </Button>
    <Button href={`${base}/contact`} variant="ghost">
      <Icon name="lucide:mail" class="size-4" aria-hidden="true" />
      {t['hero.contact']}
    </Button>
  </div>
</section>
