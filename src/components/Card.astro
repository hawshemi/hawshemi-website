---
import { Icon } from 'astro-icon/components';
import { ui } from '../i18n/ui';

const { title, href, lang = 'en' } = Astro.props as {
  title: string;
  href?: string;
  lang?: 'en' | 'fa';
};
---
<article class="panel flex h-full flex-col p-5">
  <h3 class="text-lg font-semibold leading-snug" lang="en" dir="ltr">{title}</h3>
  <div class="mt-3 text-sm leading-relaxed text-text-secondary" lang="en" dir="ltr">
    <slot />
  </div>
  <div class="mt-4" lang="en" dir="ltr">
    <slot name="tags" />
  </div>
  {href && (
    <a href={href} class="text-link mt-auto flex min-h-11 items-center gap-2 pt-5 text-sm" lang={lang} dir={lang === 'fa' ? 'rtl' : 'ltr'}>
      {ui[lang]['works.view_project']}
      <span class="sr-only">: {title}</span>
      <Icon name="lucide:arrow-up-right" class="size-4 rtl:-scale-x-100" aria-hidden="true" />
    </a>
  )}
</article>
