---
import type { HTMLAttributes } from 'astro/types';

type AnchorProps = HTMLAttributes<'a'>;
type ButtonProps = HTMLAttributes<'button'>;

interface Props {
  variant?: 'primary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  class?: string;
  [key: string]: any;
}

const { 
  variant = 'primary', 
  size = 'md', 
  href, 
  class: className,
  ...props 
} = Astro.props;

const baseStyles = "inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border font-semibold text-center cursor-pointer";

const variants = {
  primary: "border-accent bg-accent text-bg hover:bg-text hover:border-text",
  ghost: "border-border bg-transparent text-text hover:bg-surface hover:border-text-secondary",
};

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-5 py-2.5 text-sm",
  lg: "px-5 py-3 text-base",
};

const classes = [
  baseStyles,
  variants[variant],
  sizes[size],
  className,
].filter(Boolean).join(' ');

const Element = href ? 'a' : 'button';
---

<Element href={href} class={classes} {...props}>
  <slot />
</Element>
