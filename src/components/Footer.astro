---
import SocialLinks from './SocialLinks.astro';

const year = new Date().getUTCFullYear();
const isFa = Astro.url.pathname.startsWith('/fa');
---
<footer class="site-width mt-auto border-t border-border py-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="text-sm">
      <p class="text-text-secondary">{isFa ? 'تمرکز بر کیفیت و سادگی' : 'Focused on quality and simplicity.'}</p>
      <a href="mailto:contact@hawshemi.com" lang="en" dir="ltr" class="text-link inline-flex min-h-11 items-center">contact@hawshemi.com</a>
    </div>
    <SocialLinks />
  </div>
  <p class="mt-4 text-xs text-text-secondary">
    © {new Intl.NumberFormat(isFa ? 'fa' : 'en', { useGrouping: false }).format(year)} {isFa ? 'هاشمی' : 'Hawshemi'}
  </p>
</footer>


