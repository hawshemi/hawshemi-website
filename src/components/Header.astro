---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { navEn, navFa } from '../config/navigation';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isFa = path === '/fa' || path.startsWith('/fa/');
const nav = isFa ? navFa : navEn;
---
<header class="border-b border-border">
  <div class="site-width flex flex-wrap items-center justify-between gap-x-4 py-3">
    <a href={isFa ? '/fa/' : '/'} lang="en" translate="no" class="inline-flex min-h-11 items-center gap-2.5 font-semibold tracking-tight hover:text-accent">
      <span class="size-2 rounded-sm bg-accent" aria-hidden="true"></span>
      Hawshemi
    </a>
    <nav aria-label={isFa ? 'ناوبری اصلی' : 'Main navigation'} class="order-3 mt-2 flex w-full justify-between gap-1 border-t border-border pt-2 text-sm sm:order-none sm:mt-0 sm:w-auto sm:border-0 sm:pt-0">
      {nav.map((n) => (
        <a href={n.href} aria-current={path === (n.href.replace(/\/$/, '') || '/') ? 'page' : undefined} class="nav-link px-2 sm:px-3.5">{n.label}</a>
      ))}
    </nav>
    <LanguageSwitcher />
  </div>
</header>


