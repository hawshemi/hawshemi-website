---
import { Icon } from 'astro-icon/components';

const links = [
  { label: 'GitHub', href: 'https://github.com/hawshemi', icon: 'simple-icons:github' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/hawshemi?_l=en_US', icon: 'simple-icons:linkedin' },
  { label: 'X', href: 'https://x.com/hawshemi', icon: 'simple-icons:x' },
  { label: 'Instagram', href: 'https://www.instagram.com/rhawshemi/', icon: 'simple-icons:instagram' },
];
---
<ul class="flex w-fit flex-wrap items-center gap-1" dir="ltr">
  {links.map((l) => (
    <li>
      <a 
        href={l.href} 
        aria-label={l.label}
        class="flex items-center justify-center size-11 rounded-lg text-text-secondary hover:text-accent hover:bg-surface"
      >
        <Icon name={l.icon} class="size-5" aria-hidden="true" />
      </a>
    </li>
  ))}
</ul>
