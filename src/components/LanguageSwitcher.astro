---
import { navEn } from '../config/navigation';

const path = Astro.url.pathname;
const isFa = path === '/fa' || path.startsWith('/fa/');
const contentPath = (isFa ? path.replace(/^\/fa/, '') : path).replace(/\/$/, '') || '/';
const enPath = navEn.some(n => n.href === contentPath) ? contentPath : '/';
const faPath = enPath === '/' ? '/fa/' : `/fa${enPath}`;
---
<nav aria-label={isFa ? 'زبان' : 'Language'} class="flex items-center gap-1 text-sm" dir="ltr">
  <a href={enPath} lang="en" hreflang="en" aria-current={!isFa ? 'page' : undefined} class="nav-link px-2.5">English</a>
  <span class="text-border" aria-hidden="true">/</span>
  <a href={faPath} lang="fa" hreflang="fa" aria-current={isFa ? 'page' : undefined} class="nav-link px-2.5">فارسی</a>
</nav>
