---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

const isFa = Astro.url.pathname.startsWith('/fa/');
const title = isFa ? 'صفحه پیدا نشد' : 'Page not found';
---
<BaseLayout title={title}>
  <section class="max-w-xl py-6 sm:py-12">
    <p class="mb-3 text-sm tabular-nums text-accent">404</p>
    <h1 class="page-title">{title}</h1>
    <p class="page-intro mb-6">{isFa ? 'ممکن است صفحه جابه‌جا شده باشد یا نشانی آن درست نباشد.' : 'This page may have moved, or the address may be incorrect.'}</p>
    <Button href={isFa ? '/fa/' : '/'}>{isFa ? 'بازگشت به خانه' : 'Back to home'}</Button>
  </section>
</BaseLayout>
